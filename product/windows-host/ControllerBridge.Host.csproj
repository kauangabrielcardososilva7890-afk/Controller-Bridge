<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ControllerBridge</AssemblyName>
    <RootNamespace>ControllerBridge.Host</RootNamespace>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <DefaultLanguage Condition="'$(DefaultLanguage)' == ''">auto</DefaultLanguage>
    <ApplicationIcon>..\shared-assets\ControllerBridge.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DefaultLanguage" Value="$(DefaultLanguage)" />
  </ItemGroup>
  <Target Name="ValidateDefaultLanguage" BeforeTargets="BeforeBuild">
    <Error Condition="'$(DefaultLanguage)' != 'auto' and '$(DefaultLanguage)' != 'pt-BR' and '$(DefaultLanguage)' != 'en'" Text="DefaultLanguage must be auto, pt-BR, or en." />
  </Target>
</Project>

